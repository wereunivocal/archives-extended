{
	"name": "archives-widget-extended",
	"version": "1.0.3",
	"private": true,
	"type": "module",
	"description": "Tooling for the Archives Widget Extended plugin.",
	"scripts": {
		"build": "vite build",
		"dev": "vite",
		"wp-env": "bin/wp-env.sh",
		"wp-env:start": "bin/wp-env.sh start",
		"wp-env:stop": "bin/wp-env.sh stop",
		"wp-env:destroy": "bin/wp-env.sh destroy",
		"test:phpunit": "bin/wp-env.sh run tests-cli --env-cwd=wp-content/plugins/archives-widget-extended ./vendor/bin/phpunit"
	},
	"devDependencies": {
		"@wordpress/env": "^10.0.0",
		"autoprefixer": "^10.4.0",
		"postcss": "^8.4.0",
		"vite": "^5.0.0"
	}
}
