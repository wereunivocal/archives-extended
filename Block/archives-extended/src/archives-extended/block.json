{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "aex/archives-extended",
	"version": "1.0.0",
	"title": "Archives Extended",
	"category": "widgets",
	"icon": "archive",
	"description": "An extended date archive list with custom post type and CSS class options.",
	"keywords": [ "archives", "posts" ],
	"textdomain": "archives-extended",
	"attributes": {
		"displayAsDropdown": {
			"type": "boolean",
			"default": false
		},
		"showLabel": {
			"type": "boolean",
			"default": true
		},
		"showPostCounts": {
			"type": "boolean",
			"default": false
		},
		"type": {
			"type": "string",
			"default": "monthly"
		},
		"postType": {
			"type": "string",
			"default": "post"
		},
		"extraClasses": {
			"type": "string",
			"default": ""
		},
		"itemClasses": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"anchor": true,
		"align": true,
		"html": false,
		"spacing": {
			"margin": true,
			"padding": true
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true
		},
		"color": {
			"gradients": true,
			"link": true,
			"__experimentalDefaultControls": {
				"background": true,
				"text": true,
				"link": true
			}
		},
		"interactivity": {
			"clientNavigation": true
		}
	},
	"example": {},
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css",
	"viewScript": "file:./view.js"
}
